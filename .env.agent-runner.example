# Paths only. Never put provider, GitHub, or control-plane credential values in this file.
OPENAI_API_KEY_FILE=$HOME/.config/meta-agent/secrets/openai-api-key
ANTHROPIC_API_KEY_FILE=$HOME/.config/meta-agent/secrets/anthropic-api-key
GH_TOKEN_FILE=$HOME/.config/meta-agent/secrets/github-token
META_AGENT_AUTH_TOKEN_FILE=$HOME/.config/meta-agent/secrets/control-plane-token

# Each provider has a separate container, state volume, allowlist, and provider secret mount.
# Each value is hard-clamped to 15 by the runner.
META_AGENT_OPENAI_MAX_CONCURRENCY=4
META_AGENT_ANTHROPIC_MAX_CONCURRENCY=4
CODEX_VERSION=0.146.1
CLAUDE_CODE_VERSION=2.1.220

# Refuse to start new provider work after the temporary service-account window.
META_AGENT_CREDENTIAL_EXPIRES_AT=2026-08-26T23:59:59Z
META_AGENT_OPENAI_RETRY_SECONDS=1800
META_AGENT_ANTHROPIC_RETRY_SECONDS=21600

# Prefer stateless MCP and retain bounded compatibility with 2025 servers.
META_AGENT_MCP_PROTOCOL_VERSION=2026-07-28
META_AGENT_MCP_LEGACY_PROTOCOL_VERSION=2025-11-25
