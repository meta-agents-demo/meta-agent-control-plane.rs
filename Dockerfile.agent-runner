FROM node:26.7.0-bookworm-slim@sha256:cd565714d4da3e84bfd341e31448f81d47c6362198f152345297c9c1154e6341

ARG VCS_REF=unknown

LABEL org.opencontainers.image.source="https://github.com/meta-agents-demo/meta-agent-control-plane.rs" \
      org.opencontainers.image.revision="${VCS_REF}"

COPY config/agent-runner/package.json config/agent-runner/package-lock.json /opt/meta-agent-cli/

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates gh git openssh-client python3 tini \
    && rm -rf /var/lib/apt/lists/* \
    && npm ci --prefix /opt/meta-agent-cli --omit=dev --include=optional --ignore-scripts --no-audit --no-fund \
    && node /opt/meta-agent-cli/node_modules/@anthropic-ai/claude-code/install.cjs \
    && ln -s /opt/meta-agent-cli/node_modules/.bin/codex /usr/local/bin/codex \
    && ln -s /opt/meta-agent-cli/node_modules/.bin/claude /usr/local/bin/claude \
    && codex --version >/dev/null 2>&1 \
    && claude --version >/dev/null 2>&1 \
    && npm cache clean --force \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin agent

COPY --chown=agent:agent scripts/agent_fleet.py /opt/meta-agent/agent_fleet.py
COPY --chown=agent:agent scripts/agent_observe.py /opt/meta-agent/agent_observe.py
COPY --chown=agent:agent scripts/fleet /opt/meta-agent/fleet
RUN chmod 0555 /opt/meta-agent/agent_fleet.py /opt/meta-agent/agent_observe.py \
    && ln -s /opt/meta-agent/agent_observe.py /usr/local/bin/meta-agent-observe \
    && mkdir -p /var/lib/meta-agent-runner /state/dispatcher \
    && chown agent:agent /var/lib/meta-agent-runner /state/dispatcher

USER 10001:10001
WORKDIR /var/lib/meta-agent-runner
ENTRYPOINT ["/usr/bin/tini", "--", "python3", "/opt/meta-agent/agent_fleet.py"]
CMD ["run"]
