# Generate a disposable local token, for example: openssl rand -hex 24
META_AGENT_AUTH_TOKEN=replace-with-a-synthetic-32-byte-or-longer-token
META_AGENT_RUNTIME_URL=http://127.0.0.1:8787
META_AGENT_RUNTIME_DISCOVERY_ENABLED=false
META_AGENT_RUNTIME_SAMPLE_INTERVAL_MS=1000
META_AGENT_PROCESS_PATTERNS=claude,gemini,codex,chatgpt,openai

# Optional host-hook identity overrides. Leave META_AGENT_TARGET_PID empty to let
# the native adapter find the Claude, Gemini, or Codex process in its ancestry.
META_AGENT_ID=
META_AGENT_MODEL=
META_AGENT_TARGET_PID=
META_AGENT_HOOK_STRICT=false

# Test/ephemeral platform credentials only. Do not place personal credentials,
# browser cookies, browser profiles, or alexander.d.mills@gmail.com account data
# in this file. Inject real test keys only into the agent process at runtime.
OPENAI_API_KEY_TEST=
ANTHROPIC_API_KEY_TEST=
GEMINI_API_KEY_TEST=
AI_TEST_ACCOUNT_LABEL=ephemeral-agent-runtime
