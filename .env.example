# Generate a disposable local token, for example: openssl rand -hex 24
META_AGENT_AUTH_TOKEN=replace-with-a-synthetic-32-byte-or-longer-token
META_AGENT_RUNTIME_DISCOVERY_ENABLED=false
META_AGENT_RUNTIME_SAMPLE_INTERVAL_MS=1000
META_AGENT_PROCESS_PATTERNS=claude,gemini,codex,chatgpt,openai

# Test/ephemeral platform credentials only. Do not place personal credentials,
# browser cookies, or alexander.d.mills@gmail.com account data in this file.
OPENAI_API_KEY_TEST=
ANTHROPIC_API_KEY_TEST=
GEMINI_API_KEY_TEST=
AI_TEST_ACCOUNT_LABEL=ephemeral-agent-runtime
