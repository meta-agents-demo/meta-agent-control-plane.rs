{
  "components": {
    "schemas": {
      "AgentRef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "provider",
          "model"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "instance_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          }
        }
      },
      "CoordinationPlan": {
        "additionalProperties": false,
        "description": "Deterministic read-only plan containing bounded assignments, interventions, held tasks, planning policies, and source-event provenance.",
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "planning_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_assignments",
              "max_assignments_per_agent",
              "max_interventions",
              "max_holds"
            ],
            "properties": {
              "max_assignments": {
                "type": "integer",
                "minimum": 1
              },
              "max_assignments_per_agent": {
                "type": "integer",
                "minimum": 1
              },
              "max_interventions": {
                "type": "integer",
                "minimum": 1
              },
              "max_holds": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "analysis_policy": {
            "type": "object"
          },
          "summary": {
            "type": "object"
          },
          "assignments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "interventions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "held_tasks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "generated_at",
          "revision",
          "planning_policy",
          "analysis_policy",
          "summary",
          "assignments",
          "interventions",
          "held_tasks"
        ],
        "type": "object"
      },
      "EventEnvelope": {
        "type": "object",
        "required": [
          "protocol_version",
          "event_id",
          "occurred_at",
          "agent",
          "kind",
          "data"
        ],
        "properties": {
          "protocol_version": {
            "const": "v1"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "agent": {
            "$ref": "#/components/schemas/AgentRef"
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "correlation_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "sequence": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "enum": [
              "agent_registered",
              "heartbeat",
              "goal_declared",
              "task_created",
              "task_started",
              "progress_updated",
              "reflection_recorded",
              "lesson_learned",
              "error_observed",
              "task_completed",
              "agent_status_changed"
            ]
          },
          "data": {
            "type": "object"
          }
        }
      },
      "ExplorerSnapshot": {
        "type": "object",
        "description": "Read-only bounded operator projection containing sorted agents, retained session summaries, timeline events, lessons, system pressure, counters, policy, and explicit omission counts."
      },
      "IngestAck": {
        "type": "object",
        "required": [
          "accepted",
          "duplicate",
          "event_id",
          "revision",
          "transport",
          "received_at"
        ],
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "duplicate": {
            "type": "boolean"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "transport": {
            "type": "string",
            "enum": [
              "http",
              "websocket",
              "tcp",
              "udp"
            ]
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MetacognitionSnapshot": {
        "description": "Deterministic read-only projection of visible progress, evidence, dependency, retry, stall, and consistency diagnostics.",
        "type": "object"
      },
      "Snapshot": {
        "type": "object",
        "description": "Bounded LRU projection containing agents, goals, tasks, lessons, recent events, an independent idempotency window, counters, and cache pressure."
      },
      "TransportFrame": {
        "type": "object",
        "required": [
          "event"
        ],
        "properties": {
          "token": {
            "type": [
              "string",
              "null"
            ],
            "writeOnly": true
          },
          "event": {
            "$ref": "#/components/schemas/EventEnvelope"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque"
      }
    }
  },
  "info": {
    "title": "Meta-Agent Control Plane API",
    "version": "0.1.0",
    "description": "Provider-neutral telemetry for observable agent goals, tasks, progress, explicit reflection, learned lessons, explainable metacognition, and bounded coordination recommendations. Hidden chain-of-thought is intentionally excluded."
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/bridge/rooms": {
      "get": {
        "summary": "List bounded bridge rooms",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Bridge room summaries"}, "401": {"description": "Authentication failed"}}
      },
      "post": {
        "summary": "Create an idempotent shared bridge room",
        "security": [{"bearerAuth": []}],
        "responses": {"201": {"description": "Room created or returned"}, "400": {"description": "Invalid room"}, "401": {"description": "Authentication failed"}}
      }
    },
    "/api/v1/bridge/rooms/{room_slug}": {
      "get": {
        "summary": "Read a bridge room snapshot",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Room, participants, messages, contacts, and transport counters"}, "401": {"description": "Authentication failed"}, "404": {"description": "Room not found"}}
      }
    },
    "/api/v1/bridge/rooms/{room_slug}/join": {
      "post": {
        "summary": "Declare a participant in a bridge room",
        "description": "Identity is scoped to the authenticated local control-plane boundary and is not a provider-issued assertion.",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Participant joined"}, "400": {"description": "Invalid participant"}, "401": {"description": "Authentication failed"}}
      }
    },
    "/api/v1/bridge/rooms/{room_slug}/messages": {
      "get": {
        "summary": "Read retained visible bridge summaries",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Bounded visible message summaries"}, "401": {"description": "Authentication failed"}}
      },
      "post": {
        "summary": "Post a joined participant message over HTTP",
        "description": "Accepts explicit visible summaries only; credential-like text and participant identity mismatches are rejected.",
        "security": [{"bearerAuth": []}],
        "responses": {"202": {"description": "Message accepted"}, "400": {"description": "Invalid bridge message"}, "401": {"description": "Authentication failed"}}
      }
    },
    "/api/v1/coordination": {
      "get": {
        "description": "Returns bounded dependency-safe assignments, operator interventions, and held tasks derived from visible retained state. The endpoint is read-only and never dispatches or mutates agent work.",
        "parameters": [
          {
            "name": "max_assignments",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256,
              "default": 16
            }
          },
          {
            "name": "max_assignments_per_agent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32,
              "default": 2
            }
          },
          {
            "name": "max_interventions",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512,
              "default": 32
            }
          },
          {
            "name": "max_holds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024,
              "default": 64
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoordinationPlan"
                }
              }
            },
            "description": "Current coordination plan"
          },
          "400": {
            "description": "Planning query was malformed, unknown, duplicated, zero, or above its server cap"
          },
          "401": {
            "description": "Read API authentication failed"
          },
          "500": {
            "description": "The configured planning policy could not produce a plan"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Build the current deterministic coordination plan"
      }
    },
    "/api/v1/events": {
      "post": {
        "summary": "Ingest one agent event",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventEnvelope"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Duplicate event acknowledged within the bounded idempotency window"
          },
          "202": {
            "description": "New event accepted"
          },
          "400": {
            "description": "Malformed or invalid event"
          },
          "401": {
            "description": "Authentication failed"
          }
        }
      }
    },
    "/api/v1/explorer": {
      "get": {
        "summary": "Read the bounded operator explorer projection",
        "description": "Returns sorted agents, retained sessions, recent timeline events, lessons, cache pressure, counters, and explicit retention omissions from one coherent snapshot. The endpoint is read-only.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "timeline_limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250,
              "default": 100
            }
          },
          {
            "name": "session_limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250,
              "default": 100
            }
          },
          {
            "name": "lesson_limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 250
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current operator explorer projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExplorerSnapshot"
                }
              }
            }
          },
          "400": {
            "description": "Explorer query was malformed, unknown, duplicated, zero, or above its server cap"
          },
          "401": {
            "description": "Read API authentication failed"
          },
          "500": {
            "description": "The explorer projection could not be produced"
          }
        }
      }
    },
    "/api/v1/metacognition": {
      "get": {
        "description": "Returns deterministic diagnostics, evidence-backed progress, critical paths, stalls, retry loops, and recommended actions derived only from visible retained state.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetacognitionSnapshot"
                }
              }
            },
            "description": "Current metacognition projection"
          },
          "401": {
            "description": "Read API authentication failed"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Read the current explainable metacognition projection"
      }
    },
    "/api/v1/snapshot": {
      "get": {
        "summary": "Read the current bounded in-memory projection",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current coherent projection and server revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "401": {
            "description": "Read API authentication failed"
          }
        }
      }
    },
    "/api/v1/runtime/collection": {
      "post": {
        "summary": "Enable or pause the local Linux process collector",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Collector state changed"}, "401": {"description": "Authentication failed"}}
      }
    },
    "/api/v1/runtime/commands": {
      "post": {
        "summary": "Queue a cooperative command for a hook-capable agent",
        "security": [{"bearerAuth": []}],
        "responses": {"202": {"description": "Command queued"}, "401": {"description": "Authentication failed"}, "409": {"description": "Agent is not control capable"}}
      }
    },
    "/api/v1/runtime/commands/ack": {
      "post": {
        "summary": "Acknowledge a cooperative command",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Acknowledgement recorded"}, "401": {"description": "Authentication failed"}, "404": {"description": "Command not found"}}
      }
    },
    "/api/v1/runtime/commands/poll": {
      "post": {
        "summary": "Poll pending cooperative commands",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Pending commands"}, "401": {"description": "Authentication failed"}}
      }
    },
    "/api/v1/runtime/hooks": {
      "post": {
        "summary": "Ingest an explicit provider or wrapper runtime hook",
        "security": [{"bearerAuth": []}],
        "responses": {"202": {"description": "Hook accepted"}, "400": {"description": "Invalid hook"}, "401": {"description": "Authentication failed"}}
      }
    },
    "/api/v1/runtime/host-observations": {
      "post": {
        "summary": "Ingest a privacy-minimized native host process sample",
        "description": "Fixed process identity, lineage, CPU, and RSS fields only; command arguments, environments, prompts, and credentials are outside this contract.",
        "security": [{"bearerAuth": []}],
        "responses": {"202": {"description": "Host observation accepted"}, "400": {"description": "Invalid or out-of-order observation"}, "401": {"description": "Authentication failed"}}
      }
    },
    "/api/v1/runtime/snapshot": {
      "get": {
        "summary": "Read real process and explicit hook telemetry",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Current runtime snapshot"}, "401": {"description": "Authentication failed"}}
      }
    },
    "/healthz": {
      "get": {
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Alive"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus text exposition",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Metrics"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness probe",
        "responses": {
          "200": {
            "description": "Ready"
          }
        }
      }
    },
    "/ws/bridge/{room_slug}": {
      "get": {
        "summary": "Authenticated bridge room WebSocket",
        "description": "Authenticate, join a declared participant, then exchange visible summaries and room updates.",
        "security": [{"bearerAuth": []}]
      }
    },
    "/ws/agent": {
      "get": {
        "summary": "WebSocket agent ingestion",
        "description": "Authenticate during upgrade and send EventEnvelope or TransportFrame JSON messages."
      }
    },
    "/ws/ui": {
      "get": {
        "summary": "Live projection invalidation stream",
        "description": "Emits StoreUpdate messages; clients refetch a sequence-watermarked snapshot."
      }
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Same-origin daemon API"
    }
  ],
  "x-meta-agent-event-kinds": [
    "agent_registered",
    "heartbeat",
    "goal_declared",
    "task_created",
    "task_started",
    "progress_updated",
    "reflection_recorded",
    "lesson_learned",
    "error_observed",
    "task_completed",
    "agent_status_changed"
  ],
  "x-meta-agent-udp-event-kinds": [
    "heartbeat",
    "progress_updated",
    "reflection_recorded",
    "error_observed",
    "agent_status_changed"
  ]
}
