          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "meta-agent-after-agent",
            "type": "command",
            "command": "python3 /absolute/path/to/meta-agent-control-plane.rs/examples/hooks/agent_hook_adapter.py gemini"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "meta-agent-session-end",
            "type": "command",
            "command": "python3 /absolute/path/to/meta-agent-control-plane.rs/examples/hooks/agent_hook_adapter.py gemini"
